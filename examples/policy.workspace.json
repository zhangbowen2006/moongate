{
  "version": 1,
  "name": "workspace-assistant",
  "default_decision": "deny",
  "rules": [
    {
      "id": "deny-escape",
      "tool": "fs.*",
      "decision": "deny",
      "reason": "path escapes the workspace",
      "when": [
        {
          "arg": "path",
          "prefix": [
            "..",
            "/",
            "C:/",
            "~"
          ],
          "normalize": "path"
        }
      ]
    },
    {
      "id": "read-workspace",
      "tool": "fs.read",
      "decision": "allow",
      "when": [
        {
          "arg": "path",
          "prefix": [
            "..",
            "/",
            "C:/",
            "~"
          ],
          "negate": true,
          "normalize": "path"
        }
      ]
    },
    {
      "id": "list-workspace",
      "tool": "fs.list",
      "decision": "allow",
      "when": [
        {
          "arg": "path",
          "prefix": [
            "..",
            "/",
            "C:/",
            "~"
          ],
          "negate": true,
          "normalize": "path"
        }
      ]
    },
    {
      "id": "write-report",
      "tool": "fs.write",
      "decision": "approval",
      "when": [
        {
          "arg": "path",
          "glob": [
            "reports/*",
            "reports/**"
          ]
        }
      ],
      "reason": "writes outside the report directory are reviewed by a human",
      "approval_ttl_ms": 45000
    },
    {
      "id": "no-delete",
      "tool": "fs.delete",
      "decision": "deny",
      "reason": "deletion is never delegated to an agent"
    },
    {
      "id": "internal-collector",
      "tool": "net.post",
      "decision": "allow",
      "when": [
        {
          "arg": "url",
          "glob": [
            "**/internal/**"
          ]
        }
      ]
    },
    {
      "id": "egress",
      "tool": "net.*",
      "decision": "approval",
      "reason": "outbound requests need a human"
    }
  ],
  "egress": {
    "tools": [
      "net.*",
      "mail.*"
    ],
    "on_taint": "deny"
  },
  "sensitive": [
    {
      "tool": "fs.read",
      "when": [
        {
          "arg": "path",
          "glob": [
            "**/*.env",
            "**/secrets/**",
            "**/id_rsa"
          ]
        }
      ]
    },
    {
      "tool": "vault.read"
    }
  ],
  "rate": {
    "window_ms": 60000,
    "max_calls": 30
  },
  "approval_ttl_ms": 45000,
  "min_secret_len": 12,
  "hide_denied": true,
  "mask_secrets": true,
  "reveal": [
    {
      "id": "internal-collector",
      "tool": "net.post",
      "when": [
        {
          "arg": "url",
          "glob": [
            "**/internal/**"
          ]
        }
      ],
      "reason": "the internal collector is allowed to receive the value"
    }
  ]
}
